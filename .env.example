DATABASE_URL=postgresql+psycopg://eduflow:eduflow_local@127.0.0.1:5432/eduflow_ai
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=eduflow_local
POSTGRES_DB=eduflow_ai
# setup.ps1 generates a fresh secret in .env.
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_PASSWORD=EduFlow-Demo-2026!
ORGANIZATION_SLUG=demo
INITIALIZATION_MODE=demo
# Blank mode: use a new database/institution, with a private password file for first initialization.
INSTITUTION_NAME=EduFlow 教学机构
INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD_FILE=.runtime/private/secrets/initial-admin.password
PUBLIC_ACCESS_ENABLED=false
AGENT_MODE=offline
# Future deployment placeholders; no tunnel or public listener is created by this release.
ADMIN_PORTAL_ORIGIN=http://127.0.0.1:8000
PUBLIC_PORTAL_ORIGIN=http://127.0.0.1:8100
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
