{
  "version": "2.0.0",
  "tasks": [
    { "label": "EduFlow 一键启动", "type": "shell", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["run.py"], "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] },
    { "label": "EduFlow 更新并启动", "type": "shell", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["run.py", "--rebuild"], "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONUTF8": "1" } }, "problemMatcher": [] },
    { "label": "EduFlow 本机加密备份", "type": "shell", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["run.py", "backup"], "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONUTF8": "1" } }, "problemMatcher": [] },
    { "label": "EduFlow 前端开发", "type": "shell", "command": "npm", "args": ["run", "dev"], "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] },
    { "label": "EduFlow 后端测试", "type": "shell", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["-m", "pytest", "-m", "not performance and not integration", "-q"], "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] }
  ]
}
